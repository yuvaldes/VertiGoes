# Copy to .env.local and use the values from your Supabase project's Connect dialog.
# Only a publishable key (or legacy anon key) belongs in a client app. Never use a secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional Cloudflare Turnstile site key (public). Its secret belongs only in Supabase Auth.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
